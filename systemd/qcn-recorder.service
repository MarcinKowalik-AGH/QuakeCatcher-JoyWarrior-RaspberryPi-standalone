# Author: Marcin Kowalik <mkowalik@agh.edu.pl>
[Unit]
Description=Quake-Catcher JoyWarrior24F14 RAM-first recorder
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=-/etc/qcn-recorder.conf
ExecStart=/usr/local/sbin/qcn-recorder
Restart=always
RestartSec=5
RuntimeDirectory=qcn
RuntimeDirectoryMode=0755
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
